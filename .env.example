# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_API_KEY: Alias fallback for Gemini API key if specified
AI_API_KEY=""

# AI_MODEL: AI model to use for analysis (default: gemini-3.8-flash)
AI_MODEL="gemini-3.8-flash"

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="resumeiq-jwt-super-secret-key-change-in-prod"

# PORT: Server listening port (default: 3000)
PORT="3000"

# MONGODB_URI: Optional MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/resumeiq)
# If not provided, ResumeIQ uses the robust built-in persistent disk store (.data/db.json)
MONGODB_URI=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

